<odoo>
    <data>

        <record id="view_scrum_sprint_tree" model="ir.ui.view">
            <field name="name">scrum.sprint.view.tree</field>
            <field name="model">scrum.sprint</field>
            <field name="arch" type="xml">
                <list string="Sprints SCRUM" default_order="date_begin desc">
                    <field name="name"/>
                    <field name="date_begin"/>
                    <field name="date_end"/>
                    <field name="project_id"/>
                    <field name="scrum_master_user_id"/>
                </list>
            </field>
        </record>

        <record id="view_scrum_sprint_filter" model="ir.ui.view">
            <field name="name">scrum.sprint.select</field>
            <field name="model">scrum.sprint</field>
            <field name="arch" type="xml">
                <search string="Search Sprint">
                    <field name="name" string="Sprint"/>
                    <field name="project_id" string="Project"/>
                    <field name="date_begin"/>
                    <filter name="own_sprints" string="My Sprints" domain="[('scrum_master_user_id', '=', uid)]"/>
                    <filter name="followed_by_me" string="Followed" domain="[('message_is_follower', '=', True)]"/>
                    <separator/>
                    <filter string="Open" name="open" domain="[('state', 'in', ['draft', 'in_progress'])]"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="Active"   name="active" domain="[('active', '=', True)]"/>
                    <separator/>
                    <filter string="Today" name="today"
                        domain="[('date_begin', '&lt;', context_today().strftime('%Y-%m-%d')), ('date_end', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <group>
                        <filter string="Scrum Master" name="manager" context="{'group_by': 'scrum_master_user_id'}"/>
                        <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'date_begin:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="view_sprint_card">
            <field name="name">scrum.sprint.card</field>
            <field name="model">scrum.sprint</field>
            <field name="arch" type="xml">
                <card>
                    <field name="sprint_task_count"/>
                    <templates>
                        <t t-name="card">
                            <main class="o_scrum_sprint_kanban_main">
                                <div class="mw-100">
                                    <field name="name"/>
                                    <field name="burndown_ids"
                                           style="width: 100%"
                                           widget="line_chart"
                                           options="{
                                               'chartOptions': {
                                                   'plugins': {
                                                       'legend': {
                                                           'display': False
                                                       }
                                                   },
                                                   'animation': False
                                               },
                                               'dataFields': ['date', 'planned_hours', 'available_hours'],
                                               'datasetOptions': {
                                                   'date': {
                                                       'format': 'date'
                                                   },
                                                   'planned_hours': {
                                                       'borderColor': 'red'
                                                   },
                                                   'available_hours': {
                                                       'borderColor': 'blue'
                                                   }
                                               }
                                           }"/>
                                </div>
                                <footer>
                                    <div class="d-flex align-items-center">
                                        <div class="o_project_kanban_boxes d-flex align-items-baseline">
                                            <a class="o_project_kanban_box" name="action_show_tasks" type="object">
                                                <div>
                                                    <field name="sprint_task_count"/>
                                                    <span class="o_label ms-1">Tasks</span>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </footer>
                            </main>
                        </t>
                    </templates>
                </card>
            </field>
        </record>

        <record model="ir.ui.view" id="view_sprint_kanban">
            <field name="name">scrum.sprint.kanban</field>
            <field name="model">scrum.sprint</field>
            <field name="arch" type="xml">
                <kanban class="o_project_kanban"
                        sample="1"
                        default_order="date_begin, date_end, name, id"
                        card_id="%(project_scrum.view_sprint_card)d"
                        />
            </field>
        </record>

        <record model="ir.ui.view" id="scrum_sprint_view_form">
            <field name="name">scrum.sprint.form</field>
            <field name="model">scrum.sprint</field>
            <field name="arch" type="xml">
                <form string="Sprint">
                    <field name="company_id" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="developer_ids" invisible="1"/>
                    <header>
                        <button name="action_generate_next_sprint"
                                string="Generate Next Sprint"
                                type="object"
                                class="oe_highlight"
                                groups="project_scrum.group_scrum_master"/>
                    </header>
                    <sheet string="Sprint">
                        <div class="oe_button_box" name="button_box" groups="base.group_user">
                            <button class="oe_stat_button"
                                    name="action_show_tasks"
                                    type="object" icon="check"
                                    groups="base.group_user">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="sprint_task_count" nolabel="1"/> Tasks
                                    </span>
                                </div>
                            </button>
                        </div>
                        <widget name="web_ribbon"
                                title="Archived"
                                bg_color="bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <h1 class="d-flex flex-row">
                                <field name="name"
                                       class="o_text_overflow"
                                       placeholder="e.g. Project X Sprint 001"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_id"/>
                                <field name="scrum_master_user_id"/>
                            </group>
                            <group>
                                <field name="date_begin"/>
                                <field name="date_end"/>
                                <field name="velocity_estimated"
                                       string="Estimated velocity"
                                       widget="percentage"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="Burndown">
                                <field name="burndown_ids"
                                       style="width: 100%"
                                       widget="line_chart"
                                       options="{
                                           'chartOptions': {
                                               'plugins': {
                                                   'legend': {
                                                       'display': False
                                                   }
                                               },
                                               'animation': False
                                           },
                                           'dataFields': ['date', 'planned_hours', 'available_hours'],
                                           'datasetOptions': {
                                               'date': {
                                                   'format': 'date'
                                               },
                                               'planned_hours': {
                                                   'borderColor': 'red'
                                               },
                                               'available_hours': {
                                                   'borderColor': 'blue'
                                               }
                                           }
                                       }"/>
                                <field name="burndown_ids">
                                    <list>
                                        <field name="date"/>
                                        <field name="planned_hours"/>
                                        <field name="available_hours"/>
                                    </list>
                                </field>
                            </page>
                            <page name="tasks" string="Tasks">
                                <div/>
                                <field name="sprint_task_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>  <!--:TODO: only editable by scrum master-->
                                        <field name="task_id"/> <!--:TODO: only editable by scrum master-->
                                        <field name="user_id"
                                               domain="[('id', 'in', parent.developer_ids)]"/>
                                        <field name="allocated_hours" string="Estimation"/>
                                    </list>
                                </field>
                            </page>
                            <page name="developers" string="Developers">
                                <div/>
                                <field name="developer_dedication_ids">
                                    <list editable="bottom">
                                        <field name="user_id"/>
                                        <field name="dedication" widget="percentage"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="scrum_sprint_view_task_card" model="ir.ui.view">
            <field name="name">scrum.sprint.task.card</field>
            <field name="model">scrum.sprint.task</field>
            <field name="inherit_id" ref="project.view_task_card"/>
            <field name="mode">primary</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <field name="user_ids" position="after">
                    <field name="user_id"/>
                </field>
                <!-- on click edit linked task -->
                <card position="attributes"> <!-- :TODO: ESTO DEBERÍA IR EN EL KANBAN, COMO ANTES -->
                    <attribute name="action">action_edit_task</attribute>
                    <attribute name="type">object</attribute>
                    <attribute name="default_group_by">user_id</attribute>
                    <attribute name="default_order">sequence, priority, id DESC</attribute>
                    <attribute name="group_create">False</attribute>
                </card>
                <!-- disable share action -->
                <a name="%(project.portal_share_action)d" position="replace"/>
                <!-- show current estimate -->
                <xpath expr="//footer//field[@name='priority']" position="before">
                    <div class="bg-transparent badge me-0">
                        <a name="action_update_estimation" type="object">
                            <field name="planned_hours_latest"/>
                        </a>
                    </div>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="scrum_sprint_view_task_kanban">
            <field name="name">scrum.sprint.task.kanban</field>
            <field name="model">scrum.sprint.task</field>
            <field name="arch" type="xml">
                <kanban class="o_project_kanban"
                        default_group_by="user_id"
                        sample="1"
                        default_order="sequence, priority, id DESC"
                        card_id="%(project_scrum.scrum_sprint_view_task_card)d"
                        />
            </field>
        </record>

        <record id="view_scrum_sprint_task_tree" model="ir.ui.view">
            <field name="name">scrum.sprint.task.view.tree</field>
            <field name="model">scrum.sprint.task</field>
            <field name="arch" type="xml">
                <list string="Tasks SCRUM">
                    <field name="sequence" widget="handle"/>  <!--:TODO: only editable by scrum master-->
                    <field name="task_id"/> <!--:TODO: only editable by scrum master-->
                    <field name="user_id" domain="[('id', 'in', parent.developer_ids)]"/>
                    <field name="allocated_hours" string="Estimation"/>
                </list>
            </field>
        </record>

        <record id="view_scrum_sprint_task_filter" model="ir.ui.view">
            <field name="name">scrum.sprint.task.select</field>
            <field name="model">scrum.sprint.task</field>
            <field name="arch" type="xml">
                <search string="Search Sprint">
                    <field name="task_id" string="Task"/>
                    <field name="user_id" string="Responsible"/>
                </search>
            </field>
        </record>

        <record id="scrum_sprint_action_all" model="ir.actions.act_window">
            <field name="name">Sprints</field>
            <field name="res_model">scrum.sprint</field>
            <field name="domain">[]</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_sprint_kanban"/>
            <field name="search_view_id" ref="view_scrum_sprint_filter"/>
            <field name="context">{'search_default_group_by_project': 1}</field>
            <field name="target">main</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No sprints found. Let's create one!
                </p>
                <p>
                    Create sprints to handle your tasks.
                </p>
            </field>
        </record>

        <record id="scrum_sprint_action_all_no_group" model="ir.actions.act_window">
            <field name="name">Sprints</field>
            <field name="res_model">scrum.sprint</field>
            <field name="domain">[]</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="view_id" ref="view_sprint_kanban"/>
            <field name="search_view_id" ref="view_scrum_sprint_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No sprints found. Let's create one!
                </p>
                <p>
                    Create sprints to handle your tasks.
                </p>
            </field>
        </record>

        <record id="scrum_sprint_task_action_all" model="ir.actions.act_window">
            <field name="name">Sprint Tasks</field>
            <field name="res_model">scrum.sprint.task</field>
            <field name="domain">[]</field>
            <field name="view_mode">kanban,list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tasks found.
                </p>
                <p>
                    Create a sprint and add tasks to it.
                </p>
            </field>
        </record>

        <menuitem
            id="project_scrum_menu"
            groups="project.group_project_manager,project.group_project_user"
            name="Scrum"
            parent="project.menu_main_pm"
            sequence="10"/>

        <menuitem
            action="scrum_sprint_action_all"
            groups="project.group_project_manager,project.group_project_user"
            id="scrum_sprint_menu_all"
            name="Sprints"
            parent="project_scrum.project_scrum_menu"
            sequence="10"/>

        <menuitem
            action="scrum_sprint_task_action_all"
            groups="project.group_project_manager,project.group_project_user"
            id="scrum_sprint_task_menu_all"
            name="Tasks"
            parent="project_scrum.project_scrum_menu"
            sequence="20"/>

    </data>
</odoo>
