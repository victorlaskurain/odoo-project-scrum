<templates xml:space="preserve">
    <t t-name="project_scrum.Message" t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[@t-ref='this.messageContentRef']//small[@t-att-title='this.message.datetimeMedium']" position="after">
            <span t-if="this.isTaskMessageOnSprint" style="padding-left: .5em;">on task <a class="cursor-pointer" t-on-click="this.onClickTask"><i t-out="this.message.record_name"/></a></span>
        </xpath>
    </t>
</templates>
