<odoo>

  <!--:TODO: display_name está en card -->

        <record model="ir.ui.view" id="view_project_card">
            <field name="name">project.scrum.project.card</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project_card"/>
            <field name="arch" type="xml">
                <span t-att-title="record.display_name.value" position="before">
                    <field name="sprint_count"/>
                </span>
                <xpath expr="//a[@name='action_view_tasks']/parent::div"
                       position="before">
                    <div role="menuitem">
                        <a name="%(project_scrum.scrum_sprint_action_all_no_group)d"
                           type="action"
                           context="{'search_default_project_id': id}"
                           >Sprints</a>
                    </div>
                </xpath>
                <xpath expr="//a[hasclass('o_project_kanban_box') and @name='action_view_tasks']"
                       position="before">
                    <a name="%(project_scrum.scrum_sprint_action_all_no_group)d"
                       type="action"
                       context="{'search_default_project_id': id}"
                       class="o_project_kanban_box me-1">
                        <div t-if="record.sprint_count.value > 0">
                            <field name="sprint_count" class="o_value"/>
                            <span class="ms-1">Sprints</span>
                        </div>
                    </a>
                </xpath>
            </field>
        </record>

</odoo>
