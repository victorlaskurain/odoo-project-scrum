<odoo>
    <data>

        <record model="ir.ui.view" id="view_project_task_form">
            <field name="name">project.task.form</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button name="action_update_estimation"
                            type="object"
                            string="Update Estimation"
                            />
                </header>
                <xpath expr="//field[@name='planned_hours']/parent::div" position="after">
                    <field name="planned_hours_latest"
                           class="oe_inline ms-2"
                           widget="timesheet_uom_no_toggle"
                           />
                </xpath>
            </field>
        </record>

        <record id="action_add_to_scrum_sprint" model="ir.actions.act_window">
            <field name="name">Add To Scrum Sprint</field>
            <field name="res_model">add.to.scrum.sprint.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">
            {
                "default_task_ids": active_ids
            }
            </field>
            <field name="binding_model_id" ref="project.model_project_task"/>
            <field name="binding_view_types">list,form</field>
        </record>

    </data>
</odoo>
